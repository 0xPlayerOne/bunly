{
  "name": "bun-native-workspace",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:boundaries && bun run test && bun run build",
    "format": "bun fmt --no-script .",
    "format:check": "bun fmt --no-script --check .",
    "lint": "oxlint --deny-warnings packages scripts tests examples experiments",
    "typecheck": "bun --check --tsconfig-override tsconfig.json",
    "check:boundaries": "bun scripts/quality/boundaries.ts",
    "test": "bun test tests",
    "build": "bun scripts/build.ts",
    "native:check": "cargo check --locked --workspace --all-targets",
    "native:test": "cargo test --locked --workspace --all-targets",
    "native:build": "cargo build --locked -p bun-native-host --release",
    "format:native": "cargo fmt --all",
    "format:native:check": "cargo fmt --all -- --check",
    "lint:native": "cargo clippy --locked --workspace --all-targets -- -D warnings",
    "foundry:doctor": "bun --bun code-foundry doctor",
    "example": "bun examples/native-window/main.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "code-foundry": "1.48.8",
    "oxc-parser": "0.156.0",
    "oxlint": "1.90.0",
    "@bun-native/protocol": "workspace:*",
    "@bun-native/runtime": "workspace:*"
  },
  "engines": {
    "bun": "1.4.4-canary.1"
  },
  "packageManager": "bun@1.4.4-canary.1"
}
